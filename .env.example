NODE_ENV=production
PORT=5000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
JWT_SECRET=
FRONTEND_URL=https://ozonteck-loja.onrender.com
API_BASE_URL=https://ozonteck-api-staging.onrender.com

# Transporte de e-mail compartilhado (Brevo/SMTP).
NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=OZONTECK
SMTP_FROM_EMAIL=

# Web Push para navegadores/PWA. Nunca exponha a chave privada no frontend.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=suporte@ozonteck.com

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
# Compatibilidade temporária com nomes antigos do Render:
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ALLOW_UNSIGNED_WEBHOOKS=false
MERCADO_PAGO_WEBHOOK_MAX_SKEW_SECONDS=600
STORE_SUCCESS_URL=https://ozonteck-loja.onrender.com/pages-html/pagamento-sucesso.html
STORE_PENDING_URL=https://ozonteck-loja.onrender.com/pages-html/pagamento-pendente.html
STORE_FAILURE_URL=https://ozonteck-loja.onrender.com/pages-html/pagamento-falha.html
ENABLE_PAYMENT_SIMULATION=false

CORS_ORIGINS=https://ozonteck-loja.onrender.com,https://ozonteck-admin.onrender.com
STRICT_CORS=true

STORE_PAYMENT_RATE_LIMIT_MAX=30
STORE_INSTALLMENTS_RATE_LIMIT_MAX=120
STORE_ORDER_ACCESS_RATE_LIMIT_MAX=180
STORE_PAYMENT_WEBHOOK_RATE_LIMIT_MAX=240

# Conciliação automática de pagamentos Mercado Pago.
# Mantém o Admin sincronizado mesmo se uma entrega de webhook falhar.
MERCADO_PAGO_RECONCILE_ENABLED=true
MERCADO_PAGO_RECONCILE_INTERVAL_SECONDS=120
MERCADO_PAGO_RECONCILE_BATCH_LIMIT=30

# Opcional: habilita geração automática de legendas no Studio de Vídeo.
OPENAI_API_KEY=
# Alertas administrativos de estoque.
# O alerta crítico é enviado quando o estoque disponível cruza para zero.
# O alerta de estoque baixo é enviado uma única vez ao cruzar o limite abaixo.
STOCK_NOTIFICATIONS_ENABLED=true
STOCK_LOW_ALERT_THRESHOLD=5

# Notificações personalizadas de novos produtos.
# Implantação segura: aplique a migration, mantenha ENABLED=false no primeiro deploy,
# depois use ENABLED=true + DRY_RUN=true. Envio real também exige
# PRODUCT_INTEREST_CONSENT_CONFIRMED=true após revisar o texto do opt-in da loja.
PRODUCT_INTEREST_NOTIFICATIONS_ENABLED=false
PRODUCT_INTEREST_NOTIFICATIONS_DRY_RUN=true
PRODUCT_INTEREST_CONSENT_CONFIRMED=false
# Canais independentes. Web Push só alcança dispositivos que autorizaram notificações.
PRODUCT_INTEREST_EMAIL_ENABLED=true
PRODUCT_INTEREST_WEB_PUSH_ENABLED=true
# Descoberta alcança apenas clientes sem nenhum interesse qualificado recente.
# Perfis já aprendidos continuam recebendo somente campanhas compatíveis.
PRODUCT_INTEREST_DISCOVERY_ENABLED=true
PRODUCT_INTEREST_DISCOVERY_SHARE_PERCENT=20
PRODUCT_INTEREST_DISCOVERY_CANDIDATE_LIMIT=250
PRODUCT_INTEREST_LOOKBACK_DAYS=30
PRODUCT_INTEREST_HALF_LIFE_HOURS=72
PRODUCT_INTEREST_MIN_CATEGORY_SCORE=35
PRODUCT_INTEREST_MIN_CONFIDENCE=30
PRODUCT_INTEREST_MIN_MATCH_SCORE=55
PRODUCT_INTEREST_MIN_QUALIFYING_SIGNALS=1
PRODUCT_INTEREST_DAILY_CAP=1
PRODUCT_INTEREST_WEEKLY_CAP=2
# Web Push acompanha cada lançamento por padrão; use valores > 0 para limitar.
PRODUCT_INTEREST_WEB_PUSH_DAILY_CAP=0
PRODUCT_INTEREST_WEB_PUSH_WEEKLY_CAP=0
# false permite Push imediato fora da janela quando o e-mail estiver desativado.
PRODUCT_INTEREST_WEB_PUSH_RESPECT_DELIVERY_WINDOW=false
# Tamanho de cada página técnica; não limita o total de destinatários.
PRODUCT_INTEREST_PUSH_PAGE_SIZE=100
PRODUCT_INTEREST_BATCH_LIMIT=50
PRODUCT_INTEREST_JOB_LIMIT=2
PRODUCT_INTEREST_JOB_LEASE_SECONDS=300
PRODUCT_INTEREST_WORKER_INTERVAL_SECONDS=60
PRODUCT_INTEREST_PROFILE_REFRESH_LIMIT=25
PRODUCT_INTEREST_PROFILE_REFRESH_MINUTES=30
PRODUCT_INTEREST_TIMEZONE=America/Bahia
PRODUCT_INTEREST_SEND_START_HOUR=8
PRODUCT_INTEREST_SEND_END_HOUR=20
PRODUCT_INTEREST_PUBLIC_API_URL=https://ozonteck-api-staging.onrender.com
# Identidade usada somente nas notificações personalizadas de produtos.
PRODUCT_INTEREST_BRAND_NAME=levra_perfume
PRODUCT_INTEREST_BRAND_ICON_URL=https://ozonteck-loja.onrender.com/assets/images/brand/store/icon-192.png
PRODUCT_INTEREST_BRAND_BADGE_URL=https://ozonteck-loja.onrender.com/assets/images/brand/store/icon-192.png
# Opcional. O padrão é /pages-html/loja/detalhe-produto.html?id={productSlug}.
# PRODUCT_INTEREST_PRODUCT_URL_TEMPLATE=https://ozonteck-loja.onrender.com/pages-html/loja/detalhe-produto.html?id={productSlug}
PRODUCT_INTEREST_UNSUBSCRIBE_TOKEN_DAYS=365

# Admin secure session (opaque token stored only as SHA-256 in public.admin_sessions)
# Production with Admin/API on different sites should use none + Secure and CSRF protection.
ADMIN_SESSION_ABSOLUTE_TTL_HOURS=8
ADMIN_SESSION_IDLE_TTL_MINUTES=30
ADMIN_SESSION_TOUCH_INTERVAL_SECONDS=120
ADMIN_SESSION_COOKIE_SAME_SITE=none
# Optional: set a dedicated secret for hashing IP/User-Agent telemetry.
# ADMIN_SESSION_FINGERPRINT_SECRET=use-a-long-random-secret
# ADMIN_CSRF_SECRET=use-an-independent-long-random-secret
# Optional override. In production the default cookie name is __Host-oz_admin_session.
# ADMIN_SESSION_COOKIE_NAME=__Host-oz_admin_session
# Comma-separated extra origins allowed to send cookie-authenticated admin mutations.
# ADMIN_CSRF_ALLOWED_ORIGINS=https://admin.example.com

# Admin auth hardening - Etapa 4
# Máximo de sessões simultâneas por administrador. Sessões mais antigas são revogadas.
# Política fixa no código: exatamente 1 sessão administrativa ativa por admin.
# Em produção o padrão já é true. Se o User-Agent mudar, a sessão é revogada.
ADMIN_SESSION_STRICT_USER_AGENT=true
# Rate limit por IP no endpoint /auth/login. Sucessos não consomem a cota.
ADMIN_AUTH_RATE_LIMIT_MAX=10
# Bloqueio persistente por conta (HMAC do e-mail, sem e-mail em texto no banco).
ADMIN_LOGIN_GUARD_MAX_FAILURES=12
ADMIN_LOGIN_GUARD_WINDOW_MINUTES=15
ADMIN_LOGIN_GUARD_BLOCK_MINUTES=10
# Tempo mínimo de resposta em falhas de autenticação para reduzir enumeração temporal.
ADMIN_LOGIN_MIN_RESPONSE_MS=550
# Recomendado: segredo independente, aleatório e longo (>= 32 bytes).
# ADMIN_LOGIN_GUARD_SECRET=
